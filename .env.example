# =============================================================================
# Master .env.example for ai-mini-projects
# -----------------------------------------------------------------------------
# Superset of every variable used by projects 01-10. Copy to a single root
# `.env` (gitignored) and fill in only what the projects you run actually need.
# Each project's config falls back to this root file when no per-project .env
# exists, so one file at the repo root can serve them all.
#
# The "Used by" note on each block lists the projects that read it. Anything not
# listed for a project is simply ignored by that project (extra vars are safe).
# =============================================================================


# --- Provider API keys -------------------------------------------------------
# Set the key(s) for the provider(s) your target projects use. Most projects use
# OpenAI; the RAG projects (03, 04) can use Anthropic/OpenRouter instead.
# Project 05 (dating-compatibility) needs NO key -- it runs fully local.

OPENAI_API_KEY=sk-...
# Used by: 01, 02, 04, 06, 07, 08, 09, 10  (optional alt provider for 03)

ANTHROPIC_API_KEY=sk-ant-...
# Used by: 03 (default QA provider), 04 (optional)

OPENROUTER_API_KEY=sk-or-...
# Used by: 04 (default QA provider), 03 (optional)

COHERE_API_KEY=
# Used by: 03, 04  (optional -- reranking; cross-encoder reranking is local)


# --- Provider routing / base URL ---------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
# Used by: 01, 02, 06, 07  (leave blank for 08/09 to use the SDK default)

QA_PROVIDER=
# Used by: 03 (anthropic | openai | openrouter), 04 (openrouter | openai | anthropic)


# --- Model selection ---------------------------------------------------------
MODEL_NAME=gpt-4o-mini
# Used by: 01, 02, 06, 07, 08, 09, 10

QA_MODEL_NAME=claude-haiku-4-5-20251001
# Used by: 03 (Anthropic model), 04 (e.g. an OpenRouter model id)

JUDGE_MODEL_NAME=
# Used by: 04 (LLM-as-judge model id)

QA_MAX_TOKENS=1024
# Used by: 03, 04

EMBEDDING_MODEL=text-embedding-3-small
# Used by: 07, 08, 09 (OpenAI embeddings)
# Used by: 04, 06 (local, e.g. sentence-transformers/all-MiniLM-L6-v2)


# --- Databases / storage paths -----------------------------------------------
DATABASE_URL=
# Used by: 08 (sqlite:///data/tawos.db), 09 (sqlite:///data/triage.db)

CHROMADB_PATH=
# Used by: 08 (e.g. data/chromadb)


# --- Pipeline parameters -----------------------------------------------------
TAWOS_PROJECTS=APACHE
# Used by: 08 (which TAWOS projects to ingest)

TARGET_PROJECTS=SPARK,HADOOP,HDFS,FLINK,KAFKA,HIVE,CASSANDRA,HBASE,ZOOKEEPER,YARN
# Used by: 09 (Apache projects to triage)

CHUNKSIZE=50000
# Used by: 09 (chunked CSV ingestion)

NUM_QUESTIONS_PER_CONFIG=20
# Used by: 03 (synthetic QA generation)


# --- Notifications (project 09) ----------------------------------------------
# Notifications run in dry-run/simulation mode unless real credentials are set.
NOTIFY_DRY_RUN=true
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
SMTP_HOST=


# --- Runtime / telemetry guards ----------------------------------------------
# These are normally set automatically in code (os.environ.setdefault). Override
# here only if you need to. Quiet CrewAI telemetry and avoid macOS OpenMP issues.
OTEL_SDK_DISABLED=true            # Used by: 06, 07, 08, 09, 10
CREWAI_DISABLE_TELEMETRY=true     # Used by: 09, 10
CREWAI_TRACING_ENABLED=false      # Used by: 09, 10
KMP_DUPLICATE_LIB_OK=TRUE         # Used by: 09, 10 (macOS OpenMP)
OMP_NUM_THREADS=1                 # Used by: 05, 09, 10
TOKENIZERS_PARALLELISM=false      # Used by: 05, 09, 10
EMBED_DEVICE=cpu                  # Used by: 05 (sentence-transformers device)
LOG_LEVEL=INFO                    # Used by: 08, 09
