# Embeddings run LOCALLY via sentence-transformers -- no embedding API key needed.
# The only key required is a chat key for synthetic QA generation.

# QA generation provider: anthropic (default) | openai | openrouter
QA_PROVIDER=anthropic

# Anthropic (default QA provider)
ANTHROPIC_API_KEY=sk-ant-your-key-here
QA_MODEL_NAME=claude-haiku-4-5-20251001
QA_MAX_TOKENS=1024

# --- Optional alternative QA providers ---
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Optional: Cohere reranking (future)
# COHERE_API_KEY=your-cohere-key-here

# Pipeline defaults
NUM_QUESTIONS_PER_CONFIG=20
