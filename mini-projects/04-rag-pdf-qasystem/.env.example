# Embeddings and reranking can run LOCALLY (sentence-transformers, cross-encoder)
# with no API key. A chat key is needed only for answer generation + LLM judge.

# Generation/judge provider: openrouter (default) | openai | anthropic
QA_PROVIDER=openrouter
QA_MODEL_NAME=google/gemma-4-31b-it:free
JUDGE_MODEL_NAME=google/gemma-4-31b-it:free
QA_MAX_TOKENS=1024

# Provider keys (set the one matching QA_PROVIDER)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Cohere reranking (CohereReranker). Cross-encoder reranking is local.
COHERE_API_KEY=your-cohere-key-here

# Defaults
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
