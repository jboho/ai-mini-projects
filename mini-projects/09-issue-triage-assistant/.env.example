# OpenAI (used for the LLM classifier fallback, agents, and LLM-as-judge)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Database
DATABASE_URL=sqlite:///data/triage.db

# Ingestion
TARGET_PROJECTS=SPARK,HADOOP,HDFS,FLINK,KAFKA,HIVE,CASSANDRA,HBASE,ZOOKEEPER,YARN
CHUNKSIZE=50000

# Notifications run in dry-run mode unless real credentials are provided
NOTIFY_DRY_RUN=true
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
SMTP_HOST=

OTEL_SDK_DISABLED=true
LOG_LEVEL=INFO
